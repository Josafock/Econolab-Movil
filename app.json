{
  "expo": {
    "name": "ECONOLAB",
    "slug": "econolab-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "econolab",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/icon.png",
      "bundleIdentifier": "com.econolab.mobile",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.econolab.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#ffffff", "image": "./assets/branding/splash.png", "imageWidth": 180, "resizeMode": "contain" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
