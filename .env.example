# Complete with the existing backend API base, including its actual /api prefix.
# Physical Android: computer LAN address; emulator: 10.0.2.2, if backend is local.
# HTTP is for development only; production must use HTTPS.
EXPO_PUBLIC_API_URL=https://backend-econolab-escuela-1.onrender.com/api
# Datos públicos del responsable, necesarios antes de publicar en Google Play.
# La política debe existir en una página HTTPS pública, sin iniciar sesión.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
